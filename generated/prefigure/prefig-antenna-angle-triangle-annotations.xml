      <position>2</position>
      <parents>
        <grouped>prefig-antenna-angle-triangle-figure</grouped>
      </parents>
    </annotation>
    <annotation id="prefig-antenna-angle-triangle-right-rim" speech2="the right rim point, with coordinates d over 2, comma, h">
