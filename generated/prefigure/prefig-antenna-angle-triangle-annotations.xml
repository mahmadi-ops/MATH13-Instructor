        <ACTIVE>prefig-antenna-angle-triangle-dish</ACTIVE>
      </sonification>
    </annotation>
    <annotation id="prefig-antenna-angle-triangle-focus" speech2="the focus F at the point 0 comma p, about 44.3 centimeters above the vertex">
