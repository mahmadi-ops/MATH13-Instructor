<?xml version="1.0" encoding="UTF-8" ?>
<publication>
    <!-- directories are relative to the main source PreTeXt file -->
    <source>
        <directories external="../assets" generated="../generated-assets"/>
        <!-- Selects which @component-marked elements survive assembly. The
             Assignments and Review Problems chapter (copied from the skeletal
             book) marks its interactive figures component="web" and their
             one-paragraph paper stand-ins component="print"; without this
             switch PreTeXt keeps both, so each page would show the figure and
             the note saying the figure is only online. -->
        <version include="web binomial"/>
    </source>

    <common>

  


  <exercise-divisional solution="yes"/> 
        <!-- Chunk at subsection level: the divisions that used to be chapters -->
        <!-- are now sections, so chunking one level deeper keeps each of      -->
        <!-- their subdivisions on its own page, at its existing URL.          -->
        <chunking level="3"/>
      <tableofcontents level="4"/>
        <!-- When writing an article for a specific journal, you can   -->
        <!-- specify the name of the journal to get appropriate latex. -->
        <!-- See the guide for a list of valid names:
          https://pretextbook.org/doc/guide/html/appendix-journals.html#appendix-journals -->

        <!--<journal name="ams" /> -->
         <!-- QR code image: set path to an image to put in center of QR codes -->
      <!-- <qrcode image="image.png" /> -->
    </common>

    <!--  <numbering> -->
    <!-- the divisions element describes the numbering of divisions.  -->
    <!-- @part-structure should be "decorative" or "structural",      -->
    <!-- were the latter would restart numbering chapters within each -->
    <!-- part (this only matters if your book has parts).             -->
    <!-- The attribute @chapter-start give the number of the first    -->
    <!-- chapter.  @level says how deep (chapter->section->subsection)-->
    <!-- numbering should appear.                                     -->
    <!-- For use with a book organized by part, you can set the -->
    <!--  @part-structure to "decorative" or "structural" -->
    <!-- <divisions level="3"/> -->

    <!-- The next elements say how the levels deep to break up the    -->
    <!-- numbering of the respective elements. Can't be more than the -->
    <!-- @level on divisions above.                                   -->
    <!--  <blocks level="1" /> -->
    <!--  <examples level="2" /> -->
    <!--  <figures level="3"/> -->

  <!-- </numbering> -->

 <numbering>
  <!-- Everything sits one division deeper than it used to, now that the
       former top-level sections are grouped under four chapters, so each
       level below is one greater than before the regrouping. -->
  <divisions level="4" />
  <blocks level="2" />
  <projects level="3" />
  <equations level="2" />
  <footnotes level="2" />
</numbering>

  <!-- 
  <source/>
  <html>
     Activates the pre-configured wide stylesheet layout 
    <css style="wide"/>
  </html> 
  -->

  <!-- publication.ptx -->

<!--  <source>
  <directories external="assets" generated="generated-assets"/>
</source> -->
  <html>
    <!-- "maximum" renders every cross-reference to a numbered object as a  -->
    <!-- knowl that opens in place and carries an "in context" link, on the  -->
    <!-- same page as well as across pages; references to divisions stay     -->
    <!-- ordinary links.  This was "cross-page" because annotated PreFigure  -->
    <!-- diagrams are drawn by diagcess.js, which scans for its              -->
    <!-- .ChemAccess-element divs once at page load, so a figure injected    -->
    <!-- later by a knowl could come up empty.  custom.js watches for those  -->
    <!-- late arrivals and initializes them (see initLateDiagrams there);    -->
    <!-- if an annotated figure ever opens blank inside a knowl, that is the -->
    <!-- code to look at first, not this setting.                            -->
    <cross-references knowled="maximum"/>
    <webwork divisional="dynamic"/>
  </html>
</publication>
