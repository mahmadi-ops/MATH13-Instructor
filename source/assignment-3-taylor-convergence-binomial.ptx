  <annotation ref="sa-f" text="The function y equals sine x."/>
  <annotation ref="sa-p" text="The cubic Taylor polynomial x minus x cubed over six."/>
  <annotation ref="sa-left" text="The left endpoint of the interval, x equals negative zero point eight six three."/>
  <annotation ref="sa-right" text="The right endpoint of the interval, x equals zero point eight six three. Inside the interval the error is at most four thousandths."/>
</annotation>
