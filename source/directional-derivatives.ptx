        thickness="2"/>
<point at="gd-P0" p="(1,1)" fill="black" alignment="e">
<m>P_0(1,1)</m>
</point>
<label at="gd-increase-label" anchor="(1.7,1.75)" alignment="ne"
       color="#009E73">
<m>\nabla f/\|\nabla f\|</m>
</label>
<label at="gd-decrease-label" anchor="(0.38,0.28)" alignment="sw"
