        thickness="2" fill="none"/>
<circle at="gd-level4" center="(0,0)" radius="1.732" stroke="#7F7F7F"
        fill="none"/>
<line at="gd-tangent" endpoints="((0.15,1.85),(1.85,0.15))" stroke="#7F7F7F"
      dash="6 4" thickness="1.5"/>
<vector at="gd-increase" v="(0.566,0.566)" tail="(1,1)" stroke="#009E73"
        thickness="3"/>
