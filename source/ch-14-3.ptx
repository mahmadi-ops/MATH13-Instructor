  view={-35}{20},
  xmin=-2.3, xmax=2.3, ymin=-2.3, ymax=2.3, zmin=0, zmax=5.2,
  xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
  ticks=none, clip=false,
  legend cell align=left,
  legend style={
    at={(0.01,0.99)}, anchor=north west,
    draw=gray!50, fill=white, fill opacity=0.92, text opacity=1,
