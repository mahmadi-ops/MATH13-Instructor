  },
]
% the surface
\addplot3[surf, shader=flat, draw=gray!55, fill=gray!30,
          fill opacity=0.20, draw opacity=0.20, forget plot,
          domain=-2:2, y domain=-2:2, samples=15]
  {3 - 0.25*x^2 - 0.45*y^2};
% trace in the plane x = x0 (amber)
% A white under-stroke separates the parabola from the surface mesh.
\addplot3[line width=2.4pt, orange!85!black, forget plot,
          preaction={draw=white, line width=4.2pt, opacity=1},
          line cap=round, line join=round,
          domain=-2:2, samples=65, samples y=0]
  ({0.5},{x},{2.9375 - 0.45*x^2});
% tangent line in x = x0, slope df/dy = -0.45
\addplot3[very thick, purple!60!black, forget plot,
