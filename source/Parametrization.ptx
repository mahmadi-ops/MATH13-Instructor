    <angle-marker points="((1,0),(0,0),(1.5,2.1))" radius="34" stroke="black"><m>\theta</m></angle-marker>
    <label anchor="(0.9,1.5)" alignment="nw"><m>\overrightarrow{v}_0</m></label>
    <label anchor="(0.75,0)" alignment="s" offset="(0,-2)"><m>\overrightarrow{v}_{x0}</m></label>
