<m>t\text{ (s)}</m>
</label>
<label at="dop-speed-height-lab" anchor="(-0.12,4.05)" alignment="nw">
<m>w/A</m>
</label>
<label at="dop-speed-zero-lab" anchor="(0,-4.97)" alignment="s">
<m>0</m>
</label>
<label at="dop-speed-eight-lab" anchor="(8,-4.97)" alignment="s">
<m>8</m>
</label>

<graph at="dop-speed-against" function="against" domain="(0,8)"
       stroke="#D55E00" thickness="3"/>
<graph at="dop-speed-stationary" function="stationary" domain="(0,8)"
       stroke="#8B1A4A" thickness="3"/>
<graph at="dop-speed-with" function="withwaves" domain="(0,8)"
       stroke="#009E73" thickness="3"/>

<line at="dop-speed-period-against"
      endpoints="((0,1.56),(2.6667,1.56))"
